# TopStepFitKit 仍需写入 TSDialTime 的内部可写属性；仅在编译该 Pod 时补充兼容声明。
fit_compatibility_header = '$(PODS_ROOT)/../BuildCompatibility/TSDialTime+TopStepFitKitCompatibility.h'

# AIBudsAI 预编译库依赖 WCDBSwift 的稳定 Swift ABI 符号。
post_install do |installer|
  installer.pods_project.targets.each do |target|
    if target.name == 'WCDB.swift'
      target.build_configurations.each do |configuration|
        configuration.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      end
    end

    if target.name == 'TopStepFitKit'
      target.build_configurations.each do |configuration|
        other_cflags = Array(configuration.build_settings['OTHER_CFLAGS'] || '$(inherited)')
        configuration.build_settings['OTHER_CFLAGS'] = other_cflags + ['-include', fit_compatibility_header]
      end
    end
  end
end
