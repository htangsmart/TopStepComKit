#source 'https://gitee.com/topstep/podspecs.git'
source 'https://github.com/CocoaPods/Specs.git'  # 官方源

platform :ios, '13.0'

use_frameworks! :linkage => :static

# 预编译 SDK 的二进制框架按动态框架链接了以下传递依赖
# （运行时 @rpath 加载），故强制这些传递依赖编为动态框架并嵌入 App，
# 否则启动时 dyld 会因找不到对应 framework 而崩溃。
dynamic_frameworks = ['AFNetworking', 'Protobuf', 'SocketRocket', 'SSZipArchive']
pre_install do |installer|
  installer.pod_targets.each do |pod|
    if dynamic_frameworks.include?(pod.name)
      def pod.static_framework?; false; end
      def pod.build_type; Pod::BuildType.dynamic_framework; end
    end
  end
end


target 'TopStepComKit-Git_Example' do

  
  topstep_comkit_path = '..'

  pod 'TopStepComKit-Git/Foundation', :path => topstep_comkit_path
  pod 'TopStepComKit-Git/ComKit', :path => topstep_comkit_path

  # Fit + AI
  pod 'TopStepComKit-Git/FitAIImp', :path => topstep_comkit_path

  # NPK
  pod 'TopStepComKit-Git/NpkCoreImp', :path => topstep_comkit_path

  
#  pod 'TopStepComKit', :path => '/Users/panshi/Desktop/Project/NewSDK/TopStepComKit/TopStepComKit'
#  pod 'TopStepFitKit/AI', :path => '/Users/panshi/Desktop/Project/NewSDK/TopStepComKit/TopStepFitKit'
#  pod 'TopStepAIKit', :path => '/Users/panshi/Desktop/Project/NewSDK/TopStepComKit/TopStepAIKit'
#  pod 'TopStepPersimwearKit', :path => '/Users/panshi/Desktop/Project/NewSDK/TopStepComKit/TopStepPersimwearKit'
#  pod 'TopStepNewPlatformKit', :path => '/Users/panshi/Desktop/Project/NewSDK/TopStepComKit/TopStepNewPlatformKit'
#  pod 'TopStepBleMetaKit', :path => '/Users/panshi/Desktop/Project/NewSDK/TopStepComKit/TopStepBleMetaKit'
#  pod 'TopStepInterfaceKit', :path => '/Users/panshi/Desktop/Project/NewSDK/TopStepComKit/TopStepInterfaceKit'
#  pod 'TopStepToolKit', :path => '/Users/panshi/Desktop/Project/NewSDK/TopStepComKit/TopStepToolKit'

#  pod 'TopStepComKit-Git', :git => 'https://github.com/htangsmart/TopStepComKit.git', :tag => '1.0.0-beta9'



  target 'TopStepComKit-Git_Tests' do
    inherit! :search_paths
  end
end

# AIBudsAI 预编译库依赖 WCDBSwift 的稳定 Swift ABI 符号。
post_install do |installer|
  installer.pods_project.targets.each do |target|
    next unless target.name == 'WCDB.swift'

    target.build_configurations.each do |configuration|
      configuration.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
    end
  end
end
