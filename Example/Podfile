platform :ios, '15.0'

selected_ai_provider = ENV.fetch('TS_AI_PROVIDER', 'Default')
unless %w[Default AIBuds AIYanJie AIYanJieCoexist].include?(selected_ai_provider)
  raise "不支持TS_AI_PROVIDER=#{selected_ai_provider}"
end
# 新产品与Packaging使用相同的动态默认值，让整个传递闭包遵循各Pod的真实static_framework声明。
# 旧beta15继续保持静态默认值和下方原有动态白名单。
use_frameworks! :linkage => (%w[AIYanJie AIYanJieCoexist].include?(selected_ai_provider) ? :dynamic : :static)

# 预编译 SDK 的二进制框架按动态框架链接了以下传递依赖
# （运行时 @rpath 加载），故强制这些传递依赖编为动态框架并嵌入 App，
# 否则启动时 dyld 会因找不到对应 framework 而崩溃。
# TopStepToolKit/AIBudsCore 依赖 zipzap，需同步动态构建以满足传递依赖检查。
dynamic_frameworks = ['AFNetworking', 'Protobuf', 'SocketRocket', 'SSZipArchive', 'TopStepToolKit', 'zipzap']
pre_install do |installer|
  installer.pod_targets.each do |pod|
    if dynamic_frameworks.include?(pod.name)
      def pod.static_framework?; false; end
      def pod.build_type; Pod::BuildType.dynamic_framework; end
    end
  end
end


