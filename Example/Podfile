#source 'https://gitee.com/topstep/podspecs.git'
source 'https://github.com/CocoaPods/Specs.git'  # 官方源


platform :ios, '15.0'

# 预编译 SDK 通过 @rpath 加载第三方依赖，统一动态构建并由 CocoaPods 嵌入 App。
use_frameworks!


TITAN_FFMPEG_SDK = {
  :git => 'https://github.com/creekwearable/creek_ffmpeg.git',
  :tag => '0.0.1'
}

TITAN_TOPSTEP_SDK = {
  :git => 'https://github.com/htangsmart/TopStepComKit.git',
  :tag => '1.0.0-beta21',
  :subspecs => ['ComKit', 'AIImp', 'NpkAIImp']
}

pod 'TopStepComKit-Git', TITAN_TOPSTEP_SDK
pod 'titan-offline-voice-sdk', :path => '../../TopStepComKit_backup/offline-voice-sdk'
pod 'CreekFFmpeg', TITAN_FFMPEG_SDK

target 'TopStepComKit-Git_Example' do

  target 'TopStepComKit-Git_Tests' do
    inherit! :search_paths
  end
end

target 'TopStepComKit-Git_TitanDemo' do

end

target 'TopStepComKit-Git_ReflexDemo' do

end

# TopStepFitKit 仍需写入 TSDialTime 的内部可写属性；仅在编译该 Pod 时补充兼容声明。
fit_compatibility_header = '$(PODS_ROOT)/../BuildCompatibility/TSDialTime+TopStepFitKitCompatibility.h'

# AIBudsAI 预编译库依赖 WCDBSwift 的稳定 Swift ABI 符号。
post_install do |installer|
  # AFNetworking 4.0.1 直接引用了私有头 <netinet6/in6.h>，iOS 27 SDK 将其视为模块私有头而报错。
  # <netinet/in.h> 已包含其内容，这里在每次 pod install 后移除该行。
  Dir.glob(File.join(installer.sandbox.root, 'AFNetworking', 'AFNetworking', '*.m')).each do |file|
    content = File.read(file)
    next unless content.include?('#import <netinet6/in6.h>')
    File.chmod(0644, file)
    File.write(file, content.gsub("#import <netinet6/in6.h>\n", ''))
  end

  installer.pods_project.targets.each do |target|
    # Xcode 27 / iOS 27 SDK 仅支持 15.0 及以上的部署版本，统一抬高低于 15.0 的 Pod。
    target.build_configurations.each do |configuration|
      current = configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current.nil? || Gem::Version.new(current) < Gem::Version.new('15.0')
        configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end

    if target.name == 'WCDB.swift'
      target.build_configurations.each do |configuration|
        configuration.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      end
    end

    if target.name == 'TopStepFitKit'
      target.build_configurations.each do |configuration|
        other_cflags = Array(configuration.build_settings['OTHER_CFLAGS'] || '$(inherited)')
        configuration.build_settings['OTHER_CFLAGS'] = other_cflags + ['-include', fit_compatibility_header]
      end
    end
  end
end
