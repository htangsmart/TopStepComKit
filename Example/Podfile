# CocoaPods 1.16.x 的 xcodeproj 版本尚未登记 Xcode 27 的 objectVersion 70。
# 仅补充兼容映射，不改变生成工程的其他配置。
begin
  require 'xcodeproj'
  compatibility_map = Xcodeproj::Constants::COMPATIBILITY_VERSION_BY_OBJECT_VERSION
  unless compatibility_map.key?(70)
    Xcodeproj::Constants.send(:remove_const, :COMPATIBILITY_VERSION_BY_OBJECT_VERSION)
    Xcodeproj::Constants.const_set(
      :COMPATIBILITY_VERSION_BY_OBJECT_VERSION,
      compatibility_map.merge(70 => 'Xcode 16.0').freeze
    )
  end
rescue LoadError
end

platform :ios, '15.0'

